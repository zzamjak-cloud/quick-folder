# 워크트리 디렉토리
.worktrees/

# Tauri 번들링 바이너리 (CI에서 다운로드)
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep
# 리소스 글롭(binaries/qf-mcp*)이 매칭 0건이면 tauri 빌드가 실패하므로 placeholder를 추적한다
!src-tauri/binaries/qf-mcp-placeholder
# ffmpeg-dist: placeholder만 추적 (리소스 글롭 매칭용), 실제 바이너리는 CI에서 다운로드
!src-tauri/binaries/ffmpeg-dist/
src-tauri/binaries/ffmpeg-dist/*
!src-tauri/binaries/ffmpeg-dist/placeholder

